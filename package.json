{
  "name": "@mynameistito/hcc-bin-day",
  "version": "0.1.4",
  "description": "TypeScript client for Hamilton City Council Fight the Landfill bin-day lookup API.",
  "keywords": [
    "api",
    "bin-day",
    "hamilton",
    "hamilton-city-council",
    "typescript",
    "waste"
  ],
  "homepage": "https://github.com/mynameistito/hcc-bin-day#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/hcc-bin-day/issues"
  },
  "license": "MIT",
  "author": "Tito <contact@mynameistito.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/hcc-bin-day.git"
  },
  "bin": {
    "hcc-bin-day": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "check": "ultracite check",
    "changeset": "changeset",
    "changeset-add": "bun ./scripts/changeset-add.ts",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "knip": "bunx knip@latest",
    "ci": "bun run check && bun run typecheck && bun run test && bun run build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@types/node": "^26.1.0",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.0"
  }
}
