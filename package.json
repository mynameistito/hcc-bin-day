{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "hcc-bin-day-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@types/node": "^26.6.3",
      "effect": "4.0.0",
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter @mynameistito/hcc-bin-day build && bun run --filter @mynameistito/hcc-bin-day-docs build && bun run --filter @mynameistito/hcc-bin-day-web build",
    "bins:sync": "bun apps/web/scripts/sync-hcc-bin-items.ts",
    "check": "ultracite check",
    "ci": "bun run check && bun run typecheck && bun run test && bun run build",
    "changeset": "changeset",
    "changeset-add": "bun ./packages/cli/scripts/changeset-add.ts",
    "deploy": "bun ./scripts/alchemy-command.ts deploy",
    "destroy": "bun ./scripts/alchemy-command.ts destroy",
    "dev": "bun run --filter @mynameistito/hcc-bin-day dev",
    "dev:docs": "bun run --filter @mynameistito/hcc-bin-day-docs dev",
    "dev:web": "bun run --filter @mynameistito/hcc-bin-day-web dev",
    "fix": "ultracite fix",
    "knip": "bunx knip@latest",
    "prepare": "lefthook install",
    "test": "bun run --filter '*' test --coverage",
    "typecheck": "bun run --filter '*' typecheck && bunx tsc --project tsconfig.json"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/platform-bun": "catalog:",
    "alchemy": "2.0.0-beta.80",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "vitest": "5.0.2"
  },
  "overrides": {},
  "packageManager": "bun@1.4.2"
}
