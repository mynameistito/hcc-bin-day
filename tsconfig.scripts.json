{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "noEmit": true
  },
  "files": [
    "alchemy.run.ts",
    "scripts/alchemy-command.ts",
    "scripts/build-web.ts"
  ]
}
